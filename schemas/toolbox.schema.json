{"$schema":"https://json-schema.org/draft/2020-12/schema","title":"Engineering Casebook Toolbox Entity","type":"object","required":["schema_version","id","kind","title","source_ids"],"properties":{"schema_version":{"const":1},"id":{"pattern":"^(PROD|SYS|INT|FM|NOTE)-[0-9]{3,}$"},"kind":{"enum":["product","system","intervention","failure_mode","notebook"]},"title":{"type":"string"},"source_ids":{"type":"array","items":{"pattern":"^SRC-[0-9]{4,}$"}},"case_ids":{"type":"array","items":{"pattern":"^CASE-[0-9]{3,}$"}}},"additionalProperties":true}